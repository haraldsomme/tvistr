# Neon Postgres (pooled URL for the app, unpooled for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ANTHROPIC_API_KEY=
# Put in the crawler's User-Agent so the archive owners can reach us
CONTACT_EMAIL=

# Statens vegvesen, kjøretøyoppslag på /sak
VEGVESEN_API_KEY=

# Vercel Cron's bearer token for /api/slett-saker
CRON_SECRET=
# Development only: the pay button opens the letter without Vipps (never in production)
TVISTR_HELT_BREV_UTEN_BETALING=

# Vipps MobilePay ePayment, the sales unit's keys (test: https://apitest.vipps.no, production: https://api.vipps.no)
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=
# The secret from `npm run vipps -- webhook <url>`
VIPPS_WEBHOOK_SECRET=
# Vipps Login (the sign-in) uses the same VIPPS_CLIENT_ID and VIPPS_CLIENT_SECRET. Register these redirect URIs
# in the Vipps portal: <TVISTR_URL>/logg-inn/vipps, and http://localhost:3000/logg-inn/vipps for development.

# Resend (resend.com), the receipt with the link to the case; tvistr.no is verified there (EU region)
RESEND_API_KEY=
# Sender and the address the links point to (defaults: Tvistr <kvittering@tvistr.no>, https://tvistr.no)
EPOST_FRA=
TVISTR_URL=
# Only while Vipps runs against its test environment: every receipt goes here instead of the test user's address
EPOST_TEST_TIL=
