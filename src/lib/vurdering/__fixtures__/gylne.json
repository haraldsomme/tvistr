{
  "Turbo kort etter kjøp": {
    "status": "sak",
    "grunner": [],
    "lovversjon": "etter_2024",
    "lovlinjer": [
      {
        "tema": "mangel",
        "ikon": "ja",
        "tekst": "Bilen skal ha den holdbarheten og de egenskapene du hadde grunn til å forvente. Gjør den ikke det, har den en mangel.",
        "paragraf": "forbrukerkjøpsloven § 16 første ledd bokstav a"
      },
      {
        "tema": "frist",
        "ikon": "ja",
        "tekst": "Du er innenfor fristen for å reklamere (to år fra overtakelsen).",
        "paragraf": "forbrukerkjøpsloven § 27 annet ledd første punktum"
      },
      {
        "tema": "bevisbyrde",
        "ikon": "ja",
        "tekst": "Feilen viste seg innen 2 år. Da er det selger som må bevise at feilen ikke var der da du overtok bilen.",
        "paragraf": "forbrukerkjøpsloven § 18 annet ledd",
        "uthevet": true
      },
      {
        "tema": "lovversjon",
        "ikon": "info",
        "tekst": "Kjøpet følger forbrukerkjøpsloven slik den gjelder fra 2024.",
        "paragraf": null
      }
    ],
