  "Rust etter over to år, som den er": {
    "status": "svak",
    "grunner": [
      {
        "regel": "feil_over_to_aar",
        "tekst": "En eller flere feil viste seg mer enn to år etter at du overtok bilen. For biler gjelder som regel en frist på fem år, men for slitedeler kan fristen være to år. Selger kan bruke det."
      },
      {
        "regel": "som_den_er_gammel",
        "tekst": "Bilen ble solgt «som den er» før 2024 og var over 10 år gammel eller hadde gått over 200 000 km. Da skal det mer til før bilen er i dårligere stand enn du med rimelighet kunne forvente."
      },
      {
        "regel": "slitedel_sen",
        "tekst": "Rust regnes ofte som slitasje, og feilen ble oppdaget mer enn 6 måneder etter kjøpet. Selger kan hevde at feilen skyldes normal slitasje.",
        "feilId": "karosseri"
      }
    ],
    "lovversjon": "før_2024",
    "lovlinjer": [
      {
        "tema": "frist",
        "ikon": "ja",
        "tekst": "Fristen er fem år for deler som er ment å vare vesentlig lenger enn to år, ellers to år.",
        "paragraf": "forbrukerkjøpsloven § 27 annet ledd"
      },
      {
        "tema": "bevisbyrde",
        "ikon": "nei",
        "tekst": "Feilen viste seg etter 6 måneder. Da må du selv sannsynliggjøre at feilen var der ved levering, typisk med en verkstedrapport. Brevet legger opp til det.",
        "paragraf": "forbrukerkjøpsloven § 18 annet ledd"
      },
      {
        "tema": "forbehold",
        "ikon": "ja",
        "tekst": "Bilen ble solgt «som den er». Du kan likevel reklamere hvis bilen er i dårligere stand enn du kunne forvente.",
        "paragraf": "forbrukerkjøpsloven § 17 første ledd bokstav a"
      },
      {
        "tema": "lovversjon",
        "ikon": "info",
        "tekst": "Kjøpet følger forbrukerkjøpsloven slik den gjaldt før 2024.",
        "paragraf": null
      }
    ],
